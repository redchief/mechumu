#!/usr/bin/python3
"""Virtual Comet hardware: CAN (vcan), battery (mock UPower), hardware buttons (uinput) and the
extension connector (USB/IP from the host's `mechumu` hub; its GPIO, ADC, I2C and SPI pins are a
DLN-2 adapter there, so `mechumu ctl gpio/adc` never reach this daemon; `ctl spi` and `ctl pwm <pin>`
do, to use the pins the way a guest app would).

Sets the devices up, then applies one-line commands from the host's control
port (virtio-serial org.mecha.comet.ctl, held by the host's hub: `mechumu ctl` / `mechumu ext`) and
answers each with one line: "ok ..." or "error ...", prefixed with the command's "#<id>" if it had one.
"""
import ctypes, fcntl, glob, math, os, socket, struct, subprocess, sys, threading, time
import dbus

PORT = "/dev/virtio-ports/org.mecha.comet.ctl"
UPOWER = "org.freedesktop.UPower"
DISPLAY_DEV = "/org/freedesktop/UPower/devices/DisplayDevice"
# UPower Device.State values
STATES = {"charging": 1, "discharging": 2, "full": 4}


def sh(*cmd):
    subprocess.run(cmd, check=True, capture_output=True)


def setup_can():
    if not os.path.exists("/sys/class/net/can0"):
        sh("modprobe", "vcan")
        sh("ip", "link", "add", "dev", "can0", "type", "vcan")
    sh("ip", "link", "set", "up", "can0")


# --- hardware buttons ---------------------------------------------------------------------------
# One input device per button, as the Comet's gpio-keys give mechanix-system-service (it opens one
# path per button; its drop-in points them at the /dev/input/comet-* links our udev rule makes).
EV_SYN, EV_KEY = 0, 1
BUTTONS = {  # name: (device name, key code)
    "power": ("Comet Power Button", 116),       # KEY_POWER
    "home": ("Comet Home Button", 102),         # KEY_HOME
    "volup": ("Comet Volume Up", 115),          # KEY_VOLUMEUP
    "voldown": ("Comet Volume Down", 114),      # KEY_VOLUMEDOWN
    "extension": ("Comet Extension Detect", 194),  # KEY_F24: mechanix's "extension detection" key
}
buttons = {}


def setup_buttons():
    sh("modprobe", "uinput")
    for key, (name, code) in BUTTONS.items():
        fd = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
        fcntl.ioctl(fd, 0x40045564, EV_KEY)   # UI_SET_EVBIT
        fcntl.ioctl(fd, 0x40045565, code)     # UI_SET_KEYBIT
        # struct uinput_setup: input_id (BUS_HOST 0x19, vendor, product, version), name[80], ff_effects_max
        fcntl.ioctl(fd, 0x405C5503, struct.pack("<HHHH80sI", 0x19, 0, 0, 1, name.encode(), 0))  # UI_DEV_SETUP
        fcntl.ioctl(fd, 0x5501)               # UI_DEV_CREATE
        buttons[key] = (fd, code)


def key_event(button, value):
    fd, code = buttons[button]
    os.write(fd, struct.pack("<qqHHi", 0, 0, EV_KEY, code, value) + struct.pack("<qqHHi", 0, 0, EV_SYN, 0, 0))


# --- extension connector -----------------------------------------------------------------------
# The host's hub serves the connector's USB devices over USB/IP at 10.0.2.2:3240 (QEMU user
# networking's address for the host): bus ID 1-1 is the attached extension, 1-2 the connector's
# low-speed pins (a DLN-2 adapter: I2C as /dev/i2c-comet-ext, GPIO as /dev/gpiochip-comet-ext, ADC
# as an IIO device; see 70-comet-sim.rules); 1-3 is the Comet's internal sensor bus (IMU, light,
# magnetometer; registered by the comet-board kernel module).
VHCI = "/sys/devices/platform/vhci_hcd.0"
HUB = ("10.0.2.2", 3240)
ports = {}  # bus ID -> vhci port
vhci_lock = threading.Lock()  # the I2C keep-alive thread and host commands both pick free ports
suspended = threading.Event()  # set while a Quick Boot snapshot is taken: leave the buses detached


def recv_exact(sock, n):
    buf = b""
    while len(buf) < n:
        chunk = sock.recv(n - len(buf))
        if not chunk:
            raise ConnectionError("hub closed the connection")
        buf += chunk
    return buf


def port_state(port):
    """vhci port state: 4 free, 6 in use (status columns: hub port sta spd dev sockfd local_busid)."""
    for line in open(f"{VHCI}/status").read().splitlines()[1:]:
        f = line.split()
        if f[0] == "hs" and int(f[1]) == port:
            return int(f[2])
    return None


def usb_devices():
    return {d for d in glob.glob(f"{VHCI}/usb*/*-*") if os.path.exists(f"{d}/product")}


def usbip_attach(busid):
    before = usb_devices()
    with vhci_lock, socket.create_connection(HUB, timeout=5) as sock:
        sock.sendall(struct.pack(">HHI32s", 0x0111, 0x8003, 0, busid.encode()))  # OP_REQ_IMPORT
        _, _, status = struct.unpack(">HHI", recv_exact(sock, 8))
        if status:
            raise RuntimeError(f"hub has no device {busid}")
        busnum, devnum, speed = struct.unpack(">III", recv_exact(sock, 312)[288:300])
        port = next(int(f[1]) for f in (l.split() for l in open(f"{VHCI}/status").read().splitlines()[1:])
                    if f[0] == "hs" and f[2] == "004")
        with open(f"{VHCI}/attach", "w") as a:  # the kernel takes over the socket
            a.write(f"{port} {sock.fileno()} {busnum << 16 | devnum} {speed}")
    ports[busid] = port
    for _ in range(50):  # attached means enumerated: drivers bound, as after plugging in by hand
        if usb_devices() - before:
            return
        time.sleep(0.1)
    raise RuntimeError(f"{busid} attached but never enumerated; see dmesg")


def usbip_detach(busid):
    with vhci_lock:
        port = ports.pop(busid, None)
        if port is not None and port_state(port) != 4:
            before = usb_devices()
            with open(f"{VHCI}/detach", "w") as d:
                d.write(str(port))
            for _ in range(50):  # detached means gone, so a replacement on this port is seen as new
                if len(usb_devices()) < len(before):
                    break
                time.sleep(0.1)


def setup_connector():
    sh("modprobe", "vhci-hcd")
    threading.Thread(target=keep_i2c_attached, daemon=True).start()


def keep_i2c_attached():
    """Always-there buses: the connector's pin bridge (1-2) and the Comet's internal sensor bus (1-3,
    whose devices the comet-board module registers). Reattach whenever the hub (re)starts."""
    while True:
        for busid in () if suspended.is_set() else ("1-2", "1-3"):
            port = ports.get(busid)
            if port is None or port_state(port) == 4:
                try:
                    usbip_attach(busid)
                except (OSError, RuntimeError, StopIteration):
                    pass
        time.sleep(3)


SPIDEV = "/dev/spidev-comet-ext"


def spi_transfer(tx):
    """One full-duplex transfer on the connector's SPI pins, as a userspace spidev app does it."""
    txbuf, rxbuf = ctypes.create_string_buffer(tx, len(tx)), ctypes.create_string_buffer(len(tx))
    # struct spi_ioc_transfer: tx_buf, rx_buf, len, speed_hz, delays, bits_per_word, cs_change...
    xfer = struct.pack("<QQIIHBBBBBB", ctypes.addressof(txbuf), ctypes.addressof(rxbuf), len(tx), 0, 0, 8, 0, 0, 0, 0, 0)
    fd = os.open(SPIDEV, os.O_RDWR)
    try:
        fcntl.ioctl(fd, 0x40206B00, xfer)  # SPI_IOC_MESSAGE(1)
    finally:
        os.close(fd)
    return rxbuf.raw


def pwm_chips():
    """Connector PWM3 and PWM4: comet-board's two pwmchips, made in that order."""
    chips = glob.glob("/sys/bus/usb/drivers/comet-pwm/*/pwm/pwmchip*")
    return dict(zip((3, 4), sorted(chips, key=lambda c: int(c.rsplit("pwmchip", 1)[1]))))


def set_pwm(pin, hz, duty):
    """Through sysfs, as a guest app would: export channel 0, then period, duty cycle, enable."""
    chip = pwm_chips()[pin]
    if not os.path.isdir(f"{chip}/pwm0"):
        open(f"{chip}/export", "w").write("0")
    ch = f"{chip}/pwm0"
    for _ in range(20):  # the channel's attributes appear just after export
        if os.path.exists(f"{ch}/enable"):
            break
        time.sleep(0.05)
    if hz is None:
        open(f"{ch}/enable", "w").write("0")
        return
    period = round(1e9 / hz)
    open(f"{ch}/duty_cycle", "w").write("0")  # duty must never exceed the period, old or new
    open(f"{ch}/period", "w").write(str(period))
    open(f"{ch}/duty_cycle", "w").write(str(round(period * duty / 100)))
    open(f"{ch}/enable", "w").write("1")


def i2s_card():
    """The extension's I2S sound card (the hub's 1-4), as an ALSA device name."""
    for line in open("/proc/asound/cards"):
        if "Comet SAI2" in line:
            return f"plughw:{line.split()[0]}"
    raise RuntimeError("no I2S sound card: attach an extension with i2s = True")


def i2s(op):
    """Play half a second of a 1 kHz tone at half scale, or record half a second and report its peak."""
    fmt = ["-q", "-D", i2s_card(), "-f", "S16_LE", "-r", "48000", "-c", "2", "-t", "raw"]
    if op == "play":
        tone = b"".join(struct.pack("<hh", s, s) for s in
                        (round(16384 * math.sin(2 * math.pi * 1000 * i / 48000)) for i in range(24000)))
        subprocess.run(["aplay", *fmt], input=tone, check=True, capture_output=True, timeout=10)
        return "played 0.5 s, 1 kHz at 50%"
    rec = subprocess.run(["arecord", *fmt, "-s", "24000"], check=True, capture_output=True, timeout=10).stdout
    peak = max((abs(s) for (s,) in struct.iter_unpack("<h", rec[:len(rec) // 2 * 2])), default=0)
    return f"recorded {len(rec) / 4 / 48000:.1f} s, peak {peak / 32768:.0%}"


def mock():
    return dbus.Interface(dbus.SystemBus().get_object(UPOWER, "/org/freedesktop/UPower"),
                          "org.freedesktop.DBus.Mock")


def set_battery(percent, state):
    # Comet DTS: energy-full-design 5.29 Wh, max charge 0.9 A @ 4.2 V (~3.8 W).
    # shortcut: the 2 W discharge rate is a guess, not a measured Comet figure; replace once one is known.
    full, draw, charge = 5.29, 2.0, 3.8
    energy = full * percent / 100
    mock().SetDeviceProperties(DISPLAY_DEV, {
        "Type": dbus.UInt32(2), "IsPresent": True, "State": dbus.UInt32(STATES[state]),
        "Percentage": dbus.Double(percent), "Energy": dbus.Double(energy), "EnergyFull": dbus.Double(full),
        "TimeToEmpty": dbus.Int64(int(energy / draw * 3600) if state == "discharging" else 0),
        "TimeToFull": dbus.Int64(int((full - energy) / charge * 3600) if state == "charging" else 0),
        "IconName": f"battery-level-{int(percent) // 10 * 10}{'-charging' if state == 'charging' else ''}-symbolic",
        "WarningLevel": dbus.UInt32(3 if percent <= 5 else 2 if percent <= 15 else 1),
    })
    mock().EmitSignal("org.freedesktop.UPower", "DeviceChanged", "o", [DISPLAY_DEV])


def handle(line):
    cmd, *args = line.split()
    if cmd == "unlock" and not args:  # the lock screen, through logind (the launcher listens)
        dpms = glob.glob("/sys/class/drm/card*-Virtual-*/dpms")
        if dpms and open(dpms[0]).read().strip() == "Off":  # blanked: only the power key wakes it
            key_event("power", 1)
            time.sleep(0.1)
            key_event("power", 0)
            for _ in range(30):
                if open(dpms[0]).read().strip() == "On":
                    break
                time.sleep(0.1)
        sh("loginctl", "unlock-sessions")
        return "unlocked"
    if cmd == "suspend" and not args:  # Quick Boot: USB/IP connections can't survive a snapshot
        suspended.set()
        for busid in list(ports):
            usbip_detach(busid)
        return "buses detached"
    if cmd == "resume" and len(args) == 1:  # after a Quick Boot: the host's time, then the buses back
        time.clock_settime(time.CLOCK_REALTIME, float(args[0]))
        for busid in list(ports):  # dead connections, if the snapshot was taken without suspend
            usbip_detach(busid)
        suspended.clear()
        for _ in range(100):  # the keep-alive thread reattaches them
            if all(ports.get(b) is not None and port_state(ports[b]) != 4 for b in ("1-2", "1-3")):
                return "resumed"
            time.sleep(0.1)
        raise RuntimeError("buses 1-2 and 1-3 didn't come back; see the hub's log")
    if cmd == "battery":
        percent = float(args[0])
        state = args[1] if len(args) > 1 else ("full" if percent >= 100 else "discharging")
        if not 0 <= percent <= 100 or state not in STATES:
            raise ValueError("usage: battery <0-100> [charging|discharging|full]")
        set_battery(percent, state)
        return f"battery {percent:g}% {state}"
    if cmd == "can" and len(args) == 1:
        sh("cansend", "can0", args[0])  # e.g. 123#DEADBEEF, as if sent by an extension
        return f"can0 <- {args[0]}"
    if cmd == "usb" and not args:  # what's on the connector's USB pins, as the guest sees it
        names = [open(f"{d}/product").read().strip() for d in sorted(usb_devices())]
        return ", ".join(names) or "no USB devices"
    if cmd == "sound" and not args:  # the ALSA cards the guest's drivers made
        cards = [l.split(":", 1)[1].strip() for l in open("/proc/asound/cards") if l[:3].strip().isdigit()]
        return ", ".join(cards) or "no sound cards"
    if cmd == "iio" and not args:  # the IIO devices the guest's drivers made, with the light reading
        out = []
        for d in sorted(glob.glob("/sys/bus/iio/devices/iio:device*"), key=lambda p: int(p.rsplit("device", 1)[1])):
            name = open(f"{d}/name").read().strip()
            if os.path.exists(f"{d}/in_illuminance_input"):
                name += f"={float(open(f'{d}/in_illuminance_input').read()):g}lux"
            out.append(name)
        return " ".join(out) or "no IIO devices"
    if cmd == "spi" and len(args) == 1:  # e.g. spi a5ff: MOSI bytes in, MISO bytes out
        try:
            tx = bytes.fromhex(args[0])
        except ValueError:
            tx = b""
        if not 0 < len(tx) <= 256:
            raise ValueError("usage: spi <1-256 bytes as hex>")
        return f"spi {tx.hex()} -> {spi_transfer(tx).hex()}"
    if cmd == "pwm" and args and args[0] in ("3", "4") and (args[1:] == ["off"] or len(args) == 3):
        pin = int(args[0])
        if args[1] == "off":
            set_pwm(pin, None, 0)
            return f"PWM{pin} off"
        hz, duty = float(args[1]), float(args[2])
        if not (0 < hz <= 1e8 and 0 <= duty <= 100):
            raise ValueError("usage: pwm <3|4> <hz> <duty 0-100> | pwm <3|4> off")
        set_pwm(pin, hz, duty)
        return f"PWM{pin} {hz:g} Hz, {duty:g}% duty"
    if cmd == "i2s" and args in (["play"], ["record"]):
        return i2s(args[0])
    if cmd == "bus" and len(args) == 2 and args[0] in ("attach", "detach") and args[1] == "1-4":
        # the attached extension's I2S sound card: comes and goes with it; no detect key of its own
        usbip_detach(args[1])
        if args[0] == "attach":
            usbip_attach(args[1])
        return f"{args[1]} {args[0]}ed"
    if cmd == "button" and len(args) == 1 and args[0] in BUTTONS and args[0] != "extension":
        key_event(args[0], 1)
        time.sleep(0.1)
        key_event(args[0], 0)
        return f"{args[0]} pressed"
    if cmd == "ext" and len(args) == 2 and args[0] in ("attach", "detach"):
        if args[0] == "attach":  # replaces whatever is attached, like swapping extensions by hand
            if args[1] in ports:
                usbip_detach(args[1])
                key_event("extension", 0)
            usbip_attach(args[1])
            key_event("extension", 1)
        else:
            usbip_detach(args[1])
            key_event("extension", 0)
        return f"{args[1]} {args[0]}ed"
    raise ValueError("commands: unlock | battery <pct> [state] | can <id>#<hex> | button power|home|volup|voldown | spi <hex> | pwm <3|4> <hz> <duty>|off | i2s play|record | usb | iio | sound")


def main():
    setup_can()
    setup_buttons()
    setup_connector()
    for _ in range(50):  # UPower mock starts alongside us
        try:
            set_battery(80, "discharging")
            break
        except dbus.DBusException:
            time.sleep(0.2)
    print("comet-simd: can0, battery, buttons, connector ready", flush=True)
    if os.environ.get("NOTIFY_SOCKET"):  # Type=notify: the button devices exist now
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as n:
            n.sendto(b"READY=1", os.environ["NOTIFY_SOCKET"].replace("@", "\0", 1))
    while True:
        served = False
        try:
            with open(PORT, "r+b", buffering=0) as port:
                for raw in port:
                    served = True
                    line = raw.decode(errors="replace").strip()
                    if not line:
                        continue
                    tag = ""
                    if line.startswith("#"):  # the hub's request ID; echoed so it can match replies
                        tag, _, line = line.partition(" ")
                        tag += " "
                    try:
                        reply = tag + "ok " + handle(line)
                    except Exception as e:  # report every failure to the host, keep serving
                        reply = f"{tag}error {e}"
                    print(f"comet-simd: {line} -> {reply}", flush=True)
                    port.write(reply.encode() + b"\n")
        except OSError as e:
            print(f"comet-simd: control port: {e}", file=sys.stderr, flush=True)
        if not served:  # EOF with no command: host side not connected yet
            time.sleep(0.5)
        # else reopen at once: the host's next command may already be waiting


if __name__ == "__main__":
    main()
