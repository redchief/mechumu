Subject: Build against the patched mecha-wayland (build-time only)

Not for upstream: points cargo at the sibling mecha-wayland checkout that carries
0001-gles-device-override.patch. Against d895572, the source of the packaged 0.1.0-3.

diff --git a/Cargo.toml b/Cargo.toml
index e1d8992..bb87a4b 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -25,3 +25,18 @@ rustix = { version = "1.1.4", features = ["fs", "mm"] }
 assets = { git = "https://github.com/mecha-org/mecha-wayland.git", features = ["builder"] }
 serde = { version = "1.0.229", features = ["derive"] }
 toml = "0.8"
+
+# Local virt build: all mecha-wayland crates from the sibling checkout carrying the MECHA_GLES_DEVICE
+# patch; patching only renderer would mix two copies of its shared crates.
+[patch."https://github.com/mecha-org/mecha-wayland.git"]
+app            = { path = "../mecha-wayland/crates/app" }
+app-macro      = { path = "../mecha-wayland/crates/app-macro" }
+assets         = { path = "../mecha-wayland/crates/assets" }
+interactivity  = { path = "../mecha-wayland/crates/interactivity" }
+io-ring        = { path = "../mecha-wayland/crates/io-ring" }
+renderer       = { path = "../mecha-wayland/crates/renderer" }
+ui             = { path = "../mecha-wayland/crates/ui" }
+ui-macro       = { path = "../mecha-wayland/crates/ui-macro" }
+utils          = { path = "../mecha-wayland/crates/utils" }
+wayland        = { path = "../mecha-wayland/crates/wayland" }
+window-manager = { path = "../mecha-wayland/crates/window-manager" }
