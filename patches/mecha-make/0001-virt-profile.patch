diff --git a/mkosi.postinst.chroot b/mkosi.postinst.chroot
index a4d3921..9e88b29 100755
--- a/mkosi.postinst.chroot
+++ b/mkosi.postinst.chroot
@@ -47,6 +47,16 @@ VARIANT_ID="${VARIANT_ID// /-}"
     echo "VARIANT_ID=\"$VARIANT_ID\""
 } >> /etc/os-release
 
+# virt profile: without host GL (macOS QEMU has no virgl) the only EGL is llvmpipe, which the compositor
+# skips unless opted in; log to /tmp/compositor.log. The keyboard can only allocate (dumb) buffers on the
+# primary node there, not the render node. The lock script names the i.MX panel, QEMU's is Virtual-1.
+if [[ " ${PROFILES:-} " == *" virt "* ]]; then
+    sed -i 's|^export MECHA_DRM_DEVICE=.*|export MECHANIX_ALLOW_SOFTWARE_EGL=1 MECHANIX_COMP_LOG= MECHA_GLES_DEVICE=/dev/dri/card0 MECHA_SCALE=2.75|' /usr/bin/mechanix-session
+    sed -i 's|DSI-1|Virtual-1|' /usr/bin/mechanix-lock
+    # Fedora's udev rules give /dev/gpiochip* to group gpio; let the dev user drive the simulated header.
+    usermod -aG gpio "$USERNAME"
+fi
+
 # qemu profile: point phoc at the virtio-vga "Virtual-1" output (phosh's packaged default targets a different placeholder connector).
 if [[ " ${PROFILES:-} " == *" qemu "* ]]; then
     cat > /usr/share/phosh/phoc.ini <<'EOF'
diff --git a/mkosi.profiles/virt.conf b/mkosi.profiles/virt.conf
new file mode 100644
index 0000000..9c3b2df
--- /dev/null
+++ b/mkosi.profiles/virt.conf
@@ -0,0 +1,23 @@
+# Virtual Comet: the Comet arm64 image with the Mecha kernel, for QEMU's
+# `virt` machine instead of the i.MX8MP board (no devicetree, no extra trees).
+# Selected via `mkosi --profile=virt build`; built and booted by mechumu.
+
+[Output]
+Output=mechanix-os-virt
+ImageId=mechanix-os-virt
+
+[Distribution]
+Architecture=arm64
+
+[Content]
+KernelCommandLine=console=ttyAMA0
+# The Comet session (greetd -> mechanix-session) and its UI configs, without
+# Comet's USB-gadget/backlight services. Device names are fixed up in mkosi.postinst.chroot.
+# mkosi.extra.virt is filled by mechumu: its guest/ overlay, plus mechanix-compositor and
+# mechanix-keyboard built from upstream commits newer than the RPMs, which have the opt-ins
+# (MECHANIX_ALLOW_SOFTWARE_EGL, MECHA_GLES_DEVICE) that QEMU without host GL needs.
+# shortcut: built binaries overlay the RPMs'; drop them once the RPMs carry both opt-ins.
+ExtraTrees=mkosi.extra.comet/etc/greetd:/etc/greetd
+           mkosi.extra.comet/etc/skel:/etc/skel
+           mkosi.extra.comet/usr/bin:/usr/bin
+           mkosi.extra.virt
