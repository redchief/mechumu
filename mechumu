#!/bin/bash
# mechumu: a virtual Mecha Comet on QEMU. See README.md.
set -euo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
export MECHUMU_OUT=${MECHUMU_OUT:-$HERE/out}

usage() {
    cat <<'USAGE'
usage: mechumu [--device <name>] <command> [options]

  run [--app <desktop id|command>] [--frame [--browser] | --headless] [--cold]
      [--kernel <path> [--initrd <path>] [--cmdline <args>]] [-- <qemu args>]
        Boot the Virtual Comet: screen in a window, serial console here (Ctrl-A X quits).
        Resumes in seconds where 'mechumu stop' left off; --cold boots fresh.
        --frame shows the whole device in a window: buttons, extension bay, toolbar
        (the app in app/, built on first use with Rust; --browser: in your browser instead).
        --app boots straight into one app, e.g. --app org.mechanix.clock
        --kernel/--initrd/--cmdline boot a custom Linux kernel against the guest rootfs.
  ctl battery <0-100> [charging|discharging|full] | gpio [<1-5> <0|1>] | adc <1-4> <volts>
      | pwm [<3|4> <hz> <duty>|off] | i2s [play|record] | spi <hex> | can <id>#<hex> | button power|home|volup|voldown | unlock | brightness [0-100]
      | light <lux> | tilt <pitch> <roll> | accel|gyro <x> <y> <z> | heading <degrees> | sensors | iio | sound
      | tap <x> <y> | swipe <x1> <y1> <x2> <y2> [ms] | screenshot [file.png]
        Drive the running Virtual Comet's battery, connector pins, CAN bus, buttons, sensors and screen.
  stop
        Save the running Virtual Comet and quit (Quick Boot): the next 'mechumu run' resumes it.
  ext attach <keyboard|gamepad|io-breakout|model.py> | detach | status | <command...>
        Snap an extension onto the running Virtual Comet's connector, or drive the attached one.
  shell [<command...>]
        A root shell in the running Virtual Comet, or run one command there (like adb shell).
  logs [<name>]
        Follow the guest's journal, or one app's log (/tmp/<name>.log, else unit <name>).
  push <file or dir> [<guest dir>]
        Copy a build into the guest, to /opt/ by default (like adb push).
  sync <file or dir> [<guest dir>] [--once] [--restart <cmd>]
        Watch a local file or directory and sync changes into the guest (/opt/ by default).
  launch <command> [args...]
        Run a program in the running session, as the mecha user, with the session's environment.
  forward <host_port> <guest_port>
        Forward a localhost port into the running Virtual Comet over SSH (Ctrl-C stops it).
  pull [tag]
        Download a prebuilt Virtual Comet image from GitHub Releases into $MECHUMU_OUT.
  devices [rm <name>]
        List devices (--device <name>: a separate Virtual Comet, its own disk and saved state,
        created on first run as a copy of the default one), or delete one.
  evk [-- <qemu args>]
        Boot the same kernel and rootfs on QEMU's NXP i.MX8MP EVK model (serial only).
  build
        Build out/ from source in Docker (arm64 hosts: Apple Silicon or arm64 Linux).

Images live in $MECHUMU_OUT (default: out/ next to this script); --device <name> (or $MECHUMU_DEVICE)
uses $MECHUMU_OUT/devices/<name>. One Virtual Comet runs at a time: they share localhost ports.
USAGE
}

# Devices: each its own copy of the image (a clone on APFS and reflinking filesystems), not a qcow2
# overlay, since the default device keeps writing to the image an overlay would be backed by.
DEVICE=${MECHUMU_DEVICE:-}
if [[ ${1:-} == --device ]]; then DEVICE=${2:?--device needs a name}; shift 2; fi
if [[ -n $DEVICE ]]; then
    [[ $DEVICE =~ ^[A-Za-z0-9_-]+$ ]] || { echo "mechumu: device names are letters, digits, - and _" >&2; exit 2; }
    BASE=$MECHUMU_OUT/mechanix-os-virt.qcow2
    export MECHUMU_OUT=$MECHUMU_OUT/devices/$DEVICE
fi

# The guest over SSH (port 2222, localhost only). Its host key changes with every build and device,
# so it isn't recorded.
SSH_OPTS=(-p 2222 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR)
guest() { exec ssh "${SSH_OPTS[@]}" "$@"; }

cmd=${1:-help}
shift || true
if [[ $cmd == run && -n $DEVICE && ! -f $MECHUMU_OUT/mechanix-os-virt.qcow2 ]]; then
    [[ -f $BASE ]] || { echo "mechumu: no $BASE to copy - run 'mechumu build'" >&2; exit 1; }
    qemu-img info "$BASE" >/dev/null 2>&1 || { echo "mechumu: stop the running Virtual Comet first; device $DEVICE starts as a copy of its disk" >&2; exit 1; }
    mkdir -p "$MECHUMU_OUT"
    echo "mechumu: new device $DEVICE, a copy of $BASE"
    cp -c "$BASE" "$MECHUMU_OUT/" 2>/dev/null || cp --reflink=auto "$BASE" "$MECHUMU_OUT/" 2>/dev/null || cp "$BASE" "$MECHUMU_OUT/"
    qemu-img snapshot -d quickboot "$MECHUMU_OUT/mechanix-os-virt.qcow2" 2>/dev/null || true  # the original's saved state
fi
case $cmd in
    run) exec bash "$HERE/lib/run-virt.sh" "$@" ;;
    evk) exec bash "$HERE/lib/run-evk.sh" "$@" ;;
    ctl) exec python3 "$HERE/lib/ctl.py" "$@" ;;
    ext) exec python3 "$HERE/lib/ctl.py" --hub "$@" ;;
    stop) exec python3 "$HERE/lib/ctl.py" --hub stop ;;
    shell) [[ $# -gt 0 ]] && guest root@localhost "$@" || guest -t root@localhost ;;  # like adb shell: a shell line
    logs)
        [[ $# -le 1 && ${1:-x} =~ ^[A-Za-z0-9_.@-]+$ ]] || { echo "usage: mechumu logs [<name>]" >&2; exit 2; }
        [[ $# -eq 0 ]] && guest -t root@localhost journalctl -f
        guest -t root@localhost "f=/tmp/$1.log; [ -f \$f ] && exec tail -n 50 -F \$f; exec journalctl -n 50 -f -u $1" ;;
    push)
        [[ $# -ge 1 && $# -le 2 && -e $1 ]] || { echo "usage: mechumu push <file or dir> [<guest dir, default /opt>]" >&2; exit 2; }
        scp -q -r -P 2222 "${SSH_OPTS[@]:2}" "$1" "root@localhost:${2:-/opt}/" && echo "pushed to ${2:-/opt}/$(basename "$1")" ;;
    sync) exec python3 "$HERE/lib/sync.py" "$@" ;;
    launch)
        [[ $# -ge 1 ]] || { echo "usage: mechumu launch <command> [args...]" >&2; exit 2; }
        # As the session's user, with the environment of a process already on its Wayland display, or
        # else the compositor's plus its display socket (when nothing else is on screen).
        guest -t root@localhost python3 -c "$(printf '%q' '
import glob, os, pwd, sys
user = pwd.getpwnam("mecha")
env = fallback = None
for pid in filter(str.isdigit, os.listdir("/proc")):
    try:
        if os.stat(f"/proc/{pid}").st_uid != user.pw_uid:
            continue
        e = dict(kv.split("=", 1) for kv in open(f"/proc/{pid}/environ").read().split("\0") if "=" in kv)
        comm = open(f"/proc/{pid}/comm").read().strip()
    except OSError:
        continue
    if "WAYLAND_DISPLAY" in e:
        env = e
        break
    if comm.startswith("mechanix-compos"):
        fallback = e
if env is None and fallback is not None:
    sockets = sorted(p for p in glob.glob(f"/run/user/{user.pw_uid}/wayland-[0-9]*") if not p.endswith(".lock"))
    if sockets:
        env = dict(fallback, XDG_RUNTIME_DIR=f"/run/user/{user.pw_uid}", WAYLAND_DISPLAY=os.path.basename(sockets[0]))
if env is None:
    sys.exit("mechumu launch: no graphical session yet; is the Virtual Comet still booting?")
os.initgroups(user.pw_name, user.pw_gid)
os.setgid(user.pw_gid)
os.setuid(user.pw_uid)
os.chdir(user.pw_dir)
os.execvpe(sys.argv[1], sys.argv[1:], env)
')" "$(printf '%q ' "$@")" ;;
    devices)
        root=${BASE:-$MECHUMU_OUT/mechanix-os-virt.qcow2}
        root=$(dirname "$root")/devices
        if [[ ${1:-} == rm ]]; then
            [[ ${2:-} =~ ^[A-Za-z0-9_-]+$ && -d $root/$2 ]] || { echo "usage: mechumu devices rm <name>; see: mechumu devices" >&2; exit 2; }
            qemu-img info "$root/$2/mechanix-os-virt.qcow2" >/dev/null 2>&1 || { echo "mechumu: device $2 is running; stop it first" >&2; exit 1; }
            rm -rf "${root:?}/$2" && echo "deleted device $2"
            exit
        fi
        echo "default  $MECHUMU_OUT"
        for d in "$root"/*/; do
            [[ -f $d/mechanix-os-virt.qcow2 ]] || continue
            saved=$(qemu-img snapshot -l "$d/mechanix-os-virt.qcow2" 2>/dev/null | grep -q ' quickboot ' && echo "  (saved state)" || true)
            echo "$(basename "$d")$saved"
        done ;;
    build)
        command -v docker >/dev/null || { echo "mechumu build needs Docker; or run build/build.sh as root on Fedora 44 arm64" >&2; exit 1; }
        mkdir -p "$MECHUMU_OUT"
        cd "$HERE"
        # Sources go in as a tar stream, not a bind mount: macOS bind mounts show every file as
        # executable, which mkosi misreads. mechumu.env (credentials) is gitignored but needed.
        if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            files() { git ls-files -co --exclude-standard; [[ -f mechumu.env ]] && echo mechumu.env || true; }
            rev=$(git rev-parse --short HEAD 2>/dev/null || echo local)
        else
            files() { find . -path ./out -prune -o -type f -print; }
            rev=local
        fi
        files | COPYFILE_DISABLE=1 tar --no-xattrs -cf - -T - |
            # --init + process-group kill: Ctrl-C stops the whole build, not just this client.
            docker run -i --rm --privileged --init -e TINI_KILL_PROCESS_GROUP=1 \
                -v mechumu-cache:/var/cache/mechumu -v "$MECHUMU_OUT":/out -e MECHUMU_REV="$rev" \
                fedora:44 bash -euc 'mkdir /mechumu && tar -xf - -C /mechumu && /mechumu/build/build.sh /out'
        ;;
    pull)
        tag=${1:-latest}
        repo=${MECHUMU_REPO:-redchief/mechumu}
        [[ $tag == latest ]] && base="https://github.com/$repo/releases/latest/download" || base="https://github.com/$repo/releases/download/$tag"
        mkdir -p "$MECHUMU_OUT"
        echo "mechumu: downloading prebuilt image ($tag) into $MECHUMU_OUT"
        curl -fL --progress-bar "$base/mechanix-os-virt.qcow2" -o "$MECHUMU_OUT/mechanix-os-virt.qcow2.tmp"
        mv "$MECHUMU_OUT/mechanix-os-virt.qcow2.tmp" "$MECHUMU_OUT/mechanix-os-virt.qcow2"
        if curl -fsL "$base/evk-boot.tar.gz" -o "$MECHUMU_OUT/evk-boot.tar.gz.tmp"; then
            rm -rf "$MECHUMU_OUT/evk-boot"
            tar -C "$MECHUMU_OUT" -xzf "$MECHUMU_OUT/evk-boot.tar.gz.tmp"
            rm -f "$MECHUMU_OUT/evk-boot.tar.gz.tmp"
        fi
        if curl -fsL "$base/SHA256SUMS" -o "$MECHUMU_OUT/SHA256SUMS"; then
            (cd "$MECHUMU_OUT" && (sha256sum -c --ignore-missing SHA256SUMS 2>/dev/null || shasum -a 256 -c --ignore-missing SHA256SUMS))
        fi
        echo "mechumu: ready — run './mechumu run'" ;;
    forward)
        [[ $# -eq 2 && $1 =~ ^[0-9]+$ && $2 =~ ^[0-9]+$ ]] && (( $1 >= 1 && $1 <= 65535 && $2 >= 1 && $2 <= 65535 )) || {
            echo "usage: mechumu forward <host_port> <guest_port>" >&2; exit 2; }
        echo "mechumu: forwarding 127.0.0.1:$1 -> guest:$2 (Ctrl-C to stop)"
        guest -N -L "127.0.0.1:$1:127.0.0.1:$2" root@localhost ;;
    help | -h | --help) usage ;;
    *) usage >&2; exit 2 ;;
esac
