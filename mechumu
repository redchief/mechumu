#!/bin/bash
# mechumu: a virtual Mecha Comet on QEMU. See README.md.
set -euo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
export MECHUMU_OUT=${MECHUMU_OUT:-$HERE/out}

usage() {
    cat <<'USAGE'
usage: mechumu <command> [options]

  run [--app <desktop id|command>] [--frame | --headless] [-- <qemu args>]
        Boot the Virtual Comet: screen in a window, serial console here (Ctrl-A X quits).
        --frame shows the whole device in your browser: buttons, extension bay.
        --app boots straight into one app, e.g. --app org.mechanix.clock
  ctl battery <0-100> [charging|discharging|full] | gpio [<0-15> <0|1>] | can <id>#<hex>
      | button power|home|volup|voldown
        Drive the running Virtual Comet's simulated battery, GPIO header, CAN bus and buttons.
  ext attach <keyboard|gamepad|io-breakout|model.py> | detach | status | <command...>
        Snap an extension onto the running Virtual Comet's connector, or drive the attached one.
  evk [-- <qemu args>]
        Boot the same kernel and rootfs on QEMU's NXP i.MX8MP EVK model (serial only).
  build
        Build out/ from source in Docker (arm64 hosts: Apple Silicon or arm64 Linux).

Images live in $MECHUMU_OUT (default: out/ next to this script).
USAGE
}

cmd=${1:-help}
shift || true
case $cmd in
    run) exec bash "$HERE/lib/run-virt.sh" "$@" ;;
    evk) exec bash "$HERE/lib/run-evk.sh" "$@" ;;
    ctl) exec python3 "$HERE/lib/ctl.py" "$@" ;;
    ext) exec python3 "$HERE/lib/ctl.py" --hub "$@" ;;
    build)
        command -v docker >/dev/null || { echo "mechumu build needs Docker; or run build/build.sh as root on Fedora 44 arm64" >&2; exit 1; }
        mkdir -p "$MECHUMU_OUT"
        cd "$HERE"
        # Sources go in as a tar stream, not a bind mount: macOS bind mounts show every file as
        # executable, which mkosi misreads. mechumu.env (credentials) is gitignored but needed.
        if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            files() { git ls-files -co --exclude-standard; [[ -f mechumu.env ]] && echo mechumu.env || true; }
            rev=$(git rev-parse --short HEAD 2>/dev/null || echo local)
        else
            files() { find . -path ./out -prune -o -type f -print; }
            rev=local
        fi
        files | COPYFILE_DISABLE=1 tar --no-xattrs -cf - -T - |
            # --init + process-group kill: Ctrl-C stops the whole build, not just this client.
            docker run -i --rm --privileged --init -e TINI_KILL_PROCESS_GROUP=1 \
                -v mechumu-cache:/var/cache/mechumu -v "$MECHUMU_OUT":/out -e MECHUMU_REV="$rev" \
                fedora:44 bash -euc 'mkdir /mechumu && tar -xf - -C /mechumu && /mechumu/build/build.sh /out'
        ;;
    help | -h | --help) usage ;;
    *) usage >&2; exit 2 ;;
esac
